{
    // Fail on high severity and above. See README "Accepted security advisories" for
    // why each allowlisted entry is safe to defer.
    "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
    "high": true,
    "allowlist": [
        // Added 2026-10-03. braces <=3.0.3 stack exhaustion on deeply nested patterns; no patched
        // version exists. Only reachable via devDependency brighterscript (build tooling) globbing
        // repo-controlled patterns; not in the published package (`npm audit --omit=dev` is clean).
        "GHSA-vfj7-8cjw-p6xm",
        // Added 2026-11-18. picomatch <=4.0.7 ReDoS on single-branch repeated extglobs such as `+(*)`.
        // GitHub has withdrawn this advisory but npm still reports it; no patched version exists.
        // Dev-only (`npm audit --omit=dev` is clean), via devDependency brighterscript (build tooling)
        // globbing repo-controlled patterns. Remove once npm drops the withdrawn advisory.
        "GHSA-fc5q-39xc-vjpf"
    ]
}
